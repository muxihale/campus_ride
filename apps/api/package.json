{
  "name": "@campusride/api",
  "version": "0.1.0",
  "description": "REST API сервиса CampusRide",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "bun run db:generate && nest start --watch --exec bun",
    "build": "bun run db:generate && nest build",
    "start": "bun dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src/ test/ --ignore-pattern src/generated/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "bun --bun prisma generate",
    "db:validate": "bun --bun prisma validate",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:deploy": "bun --bun prisma migrate deploy",
    "db:studio": "bun --bun prisma studio",
    "db:seed": "bun run db:generate && bun --bun prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.0",
    "pg": "^8.0.0",
    "@node-rs/argon2": "^2.2.2",
    "@nestjs/throttler": "^6.7.1",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "prisma": "7.10.1",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^7.0.0",
    "@types/cookie-parser": "^1.4.9"
  }
}
